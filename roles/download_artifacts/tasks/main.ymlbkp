---

- name: Ensure /opt/microservices directory exists
  file:
    path: /opt/microservices
    state: directory
    mode: '0755'

- name: Set Nexus Authorization header
  set_fact:
    nexus_auth_header: "Basic {{ (nexus_username + ':' + nexus_password) | b64encode }}"

- name: Download latest JARs from Nexus
  get_url:
    url: "{{ nexus_base_url }}/{{ item.name }}.jar"
    dest: "/opt/microservices/{{ item.name }}.jar"
    headers:
      Authorization: "{{ nexus_auth_header }}"
    mode: '0755'
    force: yes
  loop: "{{ artifact_list }}"

